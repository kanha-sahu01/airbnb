<%- layout("/layout/boilerplate.ejs") %>
<script>
    const mapToken = "<%= (process.env.MAP_TOKEN) %>";
    const coordinates =<%- JSON.stringify(list.geometry.coordinates) %>;
</script>

    <div class="row justify-content-center">

        <div class="col-md-8 offset-2">
            <h1>Here is your all detail!</h1>
        </div>

        <div class="col-6">

            <div class="listing-card">
                <img src="<%= list.image.url %>" class="card-img-top show-img">

                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <%= list.title %>
                        </b><br>
                        <i>
                            <%= list.owner.username %>
                        </i>
                        <br>
                        <%= list.description %><br>
                            ₹<%= list.price.toLocaleString("en-IN") %><br>
                                <%= list.country %>
                    </p>
                </div>
            </div>

            <!-- Buttons start at card/image's left edge -->
            <% if(currUser&&currUser._id.equals(list.owner._id)){ %>
                <div class="d-flex gap-2 mb-3 mt-3">
                    <a href="/listing/<%= list.id %>/edit" class="btn btn-dark">
                        Edit this listing
                    </a>

                    <form action="/listing/<%= list.id %>?_method=delete" method="post">
                        <button class="btn btn-dark">
                            Delete this list
                        </button>
                    </form>
                </div>
                <% } %>

                    <div class="col-12 mt-3 mb-3">
                        <% if(currUser){ %>
                            <h3>Leave a Review</h3>
                            <form action="/listing/<%= list.id %>/review" method="post" novalidate
                                class="needs-validation">
                                <div><label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-grow">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                            value="0" checked aria-label="No rating." />
                                        <input type="radio" id="rate1" name="review[rating]" value="1" />
                                        <label for="rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="rate2" name="review[rating]" value="2" />
                                        <label for="rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="rate3" name="review[rating]" value="3" />
                                        <label for="rate3" title="Average">3 stars</label>
                                        <input type="radio" id="rate4" name="review[rating]" value="4" />
                                        <label for="rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="rate5" name="review[rating]" value="5" />
                                        <label for="rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                    <div class="invalid-feedback">Please choose a rating.</div>
                                </div>
                                <div>
                                    <label for="comment" class="form-label">Comment</label>
                                    <textarea name="review[comment]" id="comment" class="form-control" cols="30"
                                        rows="5" required></textarea>
                                    <div class="invalid-feedback">Please add a comment.</div>
                                </div>
                                <button class="btn btn-outline-dark mt-3">submit</button>
                            </form>
                            <% } %>
                    </div>

                    <div>
                        <div class="row">
                            <% for(review of list.review){ %>
                                <div class="card col-5 mb-3 ms-3">
                                    <div class="card-body">
                                        <div class="card-title">
                                            <%= review.author.username %>
                                        </div>

                                        <div class="card-text">
                                            <%= review.comment %>
                                        </div>
                                        <div class="card-text">
                                           
                                            <p class="starability-result" data-rating="<%= review.rating %>">
                                                Rated: 3 stars
                                            </p>
                                        </div>

                                    </div>
                                    <%if(currUser&&currUser._id.equals(review.author._id)){%>
                                        <form action="/listing/<%= list.id %>/review/<%= review.id %>?_method=delete"
                                            method="post"><button class="btn"><i
                                                    class="fa-solid fa-trash-can"></i></button></form>
                                        <% } %>
                                </div>
                                <% } %>
                        </div>
                    </div>
                    <div>
                        <b><h3>Where you will be</h1></b>
                    <div id="map"></div></div>
        </div>

    </div>
    <script src="/js/map.js"></script>