<%- layout("/layout/boilerplate.ejs") %>

<div class="row justify-content-center">
    <h1>Signup to Wonderlust</h1>
<form action="" method="post" novalidate class="needs-validation col-6 mt-4">
    <div class="mb-3">
        <label for="username" class="form-label">Username</label>
<input type="text" class="form-control" required name="username" placeholder="Enter Username" id="username">

            <div class="valid-feedback">looks good!</div>
</div>
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
<input type="email" class="form-control" required name="email" placeholder="Enter Email" id="email">

           
</div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
<input type="password" class="form-control" required name="password" placeholder="Enter Password" id="password">

           
</div>
<button class=" btn btn-success
">submit</button>
</form>


</div>