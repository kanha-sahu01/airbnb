<%- layout("/layout/boilerplate.ejs") %>

<div class="row justify-content-center">
    <h1 class="text-center">Login to Wonderlust</h1>

    <form action="/login" method="post" class="col-6 needs-validation" novalidate>
        <div class="mt-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" class="form-control" required placeholder="Enter Username" name="username">

        </div>
      
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
<input type="password" class="form-control" required name="password" placeholder="Enter Password" id="password">

           
</div>
<button class=" btn btn-success
">submit</button>
    </form>
</div>